# ============================================================
#  Health Nutrition Tracker — Environment Variables
#  Copy file này thành .env và điền giá trị thực
#  cp .env.example .env
# ============================================================

# ── Database ──────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=secret
MYSQL_PORT=3306

# ── Redis ─────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────
KAFKA_PORT=9092

# ── Service Ports ────────────────────────────────────────────
# HOST_PORT là port mở ra ngoài VPS; các port còn lại là port nội bộ trong Docker network.
API_GATEWAY_HOST_PORT=8080
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
NUTRITION_SERVICE_PORT=8083
MEAL_SERVICE_PORT=8084
ACTIVITY_SERVICE_PORT=8085
ANALYTICS_SERVICE_PORT=8086
AI_SERVICE_PORT=8087

# ── JWT ───────────────────────────────────────────────────
# Tối thiểu 256 bit (32 ký tự), đổi thành chuỗi ngẫu nhiên mạnh
JWT_SECRET=H3@lthNutrit10nTrackerSuperSecretKey!MustBe256BitsLong

# ── Internal Service Secret ───────────────────────────────
# Gateway inject X-Internal-Secret header vào mọi request chuyển tiếp.
# Mỗi internal service validate header này → từ chối request bypass gateway.
# ⚠️  Đổi thành chuỗi ngẫu nhiên dài trong môi trường production!
# 💡  Để trống → bỏ qua kiểm tra (local dev chạy không qua Docker)
INTERNAL_SECRET=Ht!InternalS3cret#OnlyGateway2Service

# ── OAuth2 — Google ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OAuth2 — Facebook ─────────────────────────────────────
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=no-reply@your-domain.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ── Frontend URL (OAuth2 redirect) ────────────────────────
FRONTEND_URL=http://localhost:3000
OAUTH2_REDIRECT_BASE_URL=http://localhost:8080
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8080/api/v1
REACT_APP_DISABLE_AUTH=false

# ── AI Chat (Groq - OpenAI-compatible) ─────────────────────
GROQ_API_KEY=your-groq-api-key
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.1-8b-instant
AI_TEMPERATURE=0.5
AI_GUEST_DAILY_LIMIT=5
AI_USER_DAILY_LIMIT=50

# ── Spring Profile ────────────────────────────────────────
# dev | prod
SPRING_PROFILES_ACTIVE=dev

