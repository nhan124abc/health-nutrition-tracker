# ============================================================
#  Health Nutrition Tracker — Environment Variables
#  Copy file này thành .env và điền giá trị thực
#  cp .env.example .env
# ============================================================

# ── Database ──────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=secret
MYSQL_PORT=3306

# ── Redis ─────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────
KAFKA_PORT=9092

# ── JWT ───────────────────────────────────────────────────
# Tối thiểu 256 bit (32 ký tự), đổi thành chuỗi ngẫu nhiên mạnh
JWT_SECRET=H3@lthNutrit10nTrackerSuperSecretKey!MustBe256BitsLong

# ── Internal Service Secret ───────────────────────────────
# Gateway inject X-Internal-Secret header vào mọi request chuyển tiếp.
# Mỗi internal service validate header này → từ chối request bypass gateway.
# ⚠️  Đổi thành chuỗi ngẫu nhiên dài trong môi trường production!
# 💡  Để trống → bỏ qua kiểm tra (local dev chạy không qua Docker)
INTERNAL_SECRET=Ht!InternalS3cret#OnlyGateway2Service

# ── OAuth2 — Google ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OAuth2 — Facebook ─────────────────────────────────────
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ── Frontend URL (OAuth2 redirect) ────────────────────────
FRONTEND_URL=http://localhost:3000

# ── AI Chat (Groq - OpenAI-compatible) ─────────────────────
GROQ_API_KEY=your-groq-api-key
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.1-8b-instant
AI_TEMPERATURE=0.5

# ── Spring Profile ────────────────────────────────────────
# dev | prod
SPRING_PROFILES_ACTIVE=dev

