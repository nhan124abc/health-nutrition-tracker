*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Spring Boot
# ==========================================
spring-shell.log
*.log
*.log.*
# Ignore log files nhưng giữ cấu trúc thư mục logs/
logs/**/*.log
logs/**/*.log.gz
# Không ignore .gitkeep để Git track thư mục rỗng
!logs/**/.gitkeep

